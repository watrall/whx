# Copy to .env and fill in. .env is ignored by Git.

# Photo script (scripts/fill-unsplash.mjs): https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=

# Streets map style (CARTO Voyager): https://www.carto.com/basemaps/apikey/
VITE_CARTO_KEY=

# Satellite map style (Esri World Imagery): an ArcGIS API key with the
# Basemaps > Static basemap tiles privilege
VITE_ARCGIS_TOKEN=
